# Management-approved enquiry recipient (CRM / Zapier / Make / email-service webhook).
# Receives multipart form data: all fields + optional "document" file.
# Without it, the enquiry form reports that submissions are unavailable — it never fakes success.
ENQUIRY_WEBHOOK_URL=
# Optional bearer token sent to the webhook.
ENQUIRY_WEBHOOK_TOKEN=

# Show pending (unverified) content. Defaults: true in dev, false in production.
# NEXT_PUBLIC_SHOW_UNVERIFIED=false

# Photo CDN base URL (no trailing slash). Content files use cdn("projects/tower-01.jpg")
# which becomes <this URL>/projects/tower-01.jpg. Changing it requires a rebuild/restart.
# NEXT_PUBLIC_IMAGE_CDN_URL=https://cdn.example.com/adidev
